{
  "manifest_version": 3,
  "name": "Olym AI — Agentic Browser Companion",
  "version": "1.0.0",
  "description": "Local-first AI companion that executes knowledge-work skills, parses active DOM context, and automates web workflows.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Olym AI Companion"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
